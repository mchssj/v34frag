{
  // Código que corre en Cloudflare Workers. node.ts, las pruebas y los scripts usan tsconfig.node.json
  // (los tipos de Workers y los de Node definen los mismos globales y no se pueden mezclar). udp-node.ts también es solo de Node.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/node.ts", "src/lib/udp-node.ts"]
}
