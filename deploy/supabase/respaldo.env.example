# Respaldo diario a R2 (deploy/supabase/respaldar.sh). En el VPS: /etc/cmleague/respaldo.env (root, 600).
# Sin las cuatro R2_*, el respaldo queda solo en el VPS (los últimos 7).
# Bucket: cmleague-respaldos, con una regla de ciclo de vida que borra los objetos de más de 14 días.
# Clave: un token de R2 con "Object Read & Write" solo para ese bucket (lo crea Daniel en Cloudflare).
# R2_ACCOUNT_ID es la cuenta del bucket (la de agusb06, la misma de account_id en cloudflare/demo-worker/wrangler.toml),
# no CF_ACCOUNT_ID_CLIPS: con otra cuenta, R2 responde 403 AccessDenied aunque la clave esté bien.
R2_ACCOUNT_ID=
R2_BUCKET=cmleague-respaldos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional: aviso en Discord si el respaldo falla (el mismo de DISCORD_UPTIME_WEBHOOK del .env).
DISCORD_UPTIME_WEBHOOK=
