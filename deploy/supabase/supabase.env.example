# Supabase en el VPS (plan docs/bitacora/2026-11-03-supabase-en-vps). En el VPS: /etc/cmleague/supabase.env (root, 600).
# Lo arma preparar-env.sh desde la PC: genera los secretos propios y trae de producción el JWT secret y las claves
# (API de gestión). Nunca se completa a mano ni se versiona con valores.

# --- Secretos ---
POSTGRES_PASSWORD=
# El de producción (API de gestión: /v1/projects/<ref>/postgrest, jwt_secret). Con él valen las claves legacy de
# producción. Las sesiones nuevas se firman con él (HS256); las de producción (ES256) se renuevan con su refresh token.
JWT_SECRET=
# Claves legacy de producción (JWT HS256): Worker de demos y render de clips.
ANON_KEY=
SERVICE_ROLE_KEY=
# Claves opacas de producción (sb_publishable_…, sb_secret_…): la API del VPS y el .env de la raíz.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Kong cambia una clave opaca por este JWT: son las legacy, que PostgREST y Storage validan con JWT_SECRET.
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
# Vacías: sin par de claves ES256 propio.
JWT_KEYS=
JWT_JWKS=
DASHBOARD_USERNAME=cmleague
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
# No se usan (sin Realtime ni Analytics), pero el compose las nombra.
REALTIME_DB_ENC_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=

# --- URLs ---
SUPABASE_PUBLIC_URL=https://db.cmleague.lat
API_EXTERNAL_URL=https://db.cmleague.lat
SITE_URL=https://cmleague.lat
ADDITIONAL_REDIRECT_URLS=https://cmleague.lat/**

# --- Base ---
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# --- Auth: igual que producción (correo y contraseña, sin proveedores, sin teléfono) ---
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Producción confirma sola hoy (mailer_autoconfirm). El corte anterior decidió confirmar por correo con Resend:
# cuando se haga, false y el SMTP de abajo.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
# Como deploy/auth/configurar-auth.mjs. Las plantillas de deploy/auth/plantillas/ se cargan en el corte (GoTrue las
# pide por URL: GOTRUE_MAILER_TEMPLATES_*).
SMTP_ADMIN_EMAIL=no-reply@cmleague.lat
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME=CMLeague

# --- Storage ---
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=false

# --- Studio ---
STUDIO_DEFAULT_ORGANIZATION=CMLeague
STUDIO_DEFAULT_PROJECT=Producción
OPENAI_API_KEY=

# --- Lo que el compose nombra y no se usa ---
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=cmleague
POOLER_DB_POOL_SIZE=5
FUNCTIONS_VERIFY_JWT=false
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=
