# Relay del HUD en modo VPS (hud/relay 2.0.0, plan docs/bitacora/2026-10-29-hud-relay-vps): un puerto UDP por servidor
# (27500 a 27519, abiertos en ufw) y HTTP en 127.0.0.1:8090, publicado por Caddy en hud.cmleague.lat.
# La configuración (servidores, claves y streamers) sale de la base; acá solo /etc/cmleague/hud.json con el token del
# relay. Lo que elige cada streamer en /control se guarda en /var/lib/cmleague-hud (StateDirectory).
# Se prende a mano después de completar hud.json: systemctl enable --now cmleague-hud.
[Unit]
Description=CMLeague: relay del HUD
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/cmleague/hud/current/relay.mjs

[Service]
Type=simple
User=cmleague
Group=cmleague
WorkingDirectory=/etc/cmleague
Environment=HUD_RELAY_CONFIG=/etc/cmleague/hud.json
StateDirectory=cmleague-hud
StateDirectoryMode=0700
ExecStart=/usr/bin/node --enable-source-maps /srv/cmleague/hud/current/relay.mjs
Restart=always
RestartSec=2
MemoryMax=256M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/srv/cmleague /etc/cmleague
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
