# /etc/cmleague/api.env (root, 600). Variables de la API en el VPS (plan, sección 4.1).
# Sin la clave de servicio de Supabase: la API actúa siempre con el token del usuario.
APP_ENV=production
HOST=127.0.0.1
PORT=8787
# Staging hasta el corte; producción después.
SUPABASE_URL=
SUPABASE_ANON_KEY=
FRONTEND_URL=https://cmleague.lat
CORS_ORIGINS=https://cmleague.lat
CLIENT_IP_HEADER=x-forwarded-for
DEMO_BASE_URL=
CLIPS_BASE_URL=
# Relay del HUD (links de OBS de los streamers y csstv_hud_host del cfg).
HUD_BASE_URL=https://hud.cmleague.lat
# La pone desplegar.sh con el commit.
GIT_SHA=
