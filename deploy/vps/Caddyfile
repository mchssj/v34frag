# CMLeague: Caddy con los dominios (plan docs/bitacora/2026-10-28-despliegue-vps-ovh, secciones 2 y 4).
# Se instala con `preparar.sh --dominios` cuando el DNS de Namecheap ya apunta al VPS: Caddy pide los certificados solo.

{
	servers {
		# Sin HTTP/3 (plan docs/bitacora/2026-11-20-proteccion-ddos): el flood del 2026-11-20 entró casi todo por QUIC
		# y llevó a Caddy a 3,1 GB. Los navegadores pasan solos a HTTP/2.
		protocols h1 h2
		# Detrás de Cloudflare: la IP real del cliente sale de CF-Connecting-IP, pero solo si la conexión viene de Cloudflare
		# (https://www.cloudflare.com/ips/, copiadas el 2026-11-20). Sin Cloudflare adelante, {client_ip} es la IP de la conexión.
		# 127.0.0.1 y ::1 (2026-11-26, replanteo 149): la API llama a db.cmleague.lat desde el propio VPS y manda la IP del
		# usuario en X-Forwarded-For; así la base ve la IP real para el baneo por IP. Desde Cloudflare manda
		# CF-Connecting-IP, que el cliente no puede falsificar; desde cualquier otro lado, la IP de la conexión.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 127.0.0.1/32 ::1/128
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(comun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 20MiB
			# 100 archivos (comprimidos, ~1,5 MB cada uno): con 5, el log de la base duraba ~1 hora y tras un ataque
			# no quedaba qué mirar (docs/bitacora/2026-11-20-proteccion-ddos).
			roll_keep 100
		}
	}
}

cmleague.lat {
	import comun web
	# Usuario y contraseña durante el ensayo; vacío después del corte.
	import /etc/caddy/acceso-web.caddy
	root * /srv/cmleague/web/current
	# Los archivos de Vite llevan hash en el nombre: caché de un año. El resto (index.html) se revalida siempre.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@resto not path /assets/*
	header @resto Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

www.cmleague.lat {
	redir https://cmleague.lat{uri} permanent
}

api.cmleague.lat {
	import comun api
	reverse_proxy 127.0.0.1:8787 {
		# La IP real (también detrás de Cloudflare); la API la lee con CLIENT_IP_HEADER=x-forwarded-for.
		header_up X-Forwarded-For {client_ip}
		# Que un reload de Caddy no corte los sockets del matchmaking.
		stream_close_delay 5m
	}
}

# Supabase del VPS (plan docs/bitacora/2026-11-03-supabase-en-vps): Kong en 127.0.0.1:8000. Desde afuera, solo REST,
# Auth y Storage; Studio y pg-meta, solo por túnel SSH. Kong pone el CORS. Se agrega en el corte, con el DNS listo.
db.cmleague.lat {
	import comun db
	# Las plantillas de correo que pide GoTrue (deploy/auth/plantillas/, sin secretos).
	handle_path /plantillas/* {
		root * /srv/supabase/plantillas
		file_server
	}
	@publico path /rest/v1/* /auth/v1/* /storage/v1/*
	handle @publico {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		respond 404
	}
}

# Sin Cloudflare adelante (docs/bitacora/2026-11-20-proteccion-ddos): los servidores de juego mandan el HUD por UDP a este
# nombre, y el proxy de Cloudflare no pasa UDP. Por eso en Cloudflare va en "DNS only".
# Relay del HUD (plan docs/bitacora/2026-10-29-hud-relay-vps): cada streamer entra con su token en la ruta
# (/s/<token>/hud); sin token válido el relay responde 404. Sin `comun`: la compresión puede retener los eventos (SSE)
# del HUD, y el Referer tiene que ir vacío para que el token no salga a Google Fonts.
hud.cmleague.lat {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Los tokens van en la ruta: el log guarda solo el código y la duración, sin la URL.
	log {
		output file /var/log/caddy/hud.log {
			roll_size 20MiB
			# 100 archivos (comprimidos, ~1,5 MB cada uno): con 5, el log de la base duraba ~1 hora y tras un ataque
			# no quedaba qué mirar (docs/bitacora/2026-11-20-proteccion-ddos).
			roll_keep 100
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
			}
		}
	}
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1
	}
}
