# CMLeague: Caddy con los dominios (plan docs/bitacora/2026-10-28-despliegue-vps-ovh, secciones 2 y 4).
# Se instala con `preparar.sh --dominios` cuando el DNS de Namecheap ya apunta al VPS: Caddy pide los certificados solo.

(comun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

cmleague.lat {
	import comun web
	# Usuario y contraseña durante el ensayo; vacío después del corte.
	import /etc/caddy/acceso-web.caddy
	root * /srv/cmleague/web/current
	# Los archivos de Vite llevan hash en el nombre: caché de un año. El resto (index.html) se revalida siempre.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@resto not path /assets/*
	header @resto Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

www.cmleague.lat {
	redir https://cmleague.lat{uri} permanent
}

api.cmleague.lat {
	import comun api
	# Caddy reemplaza X-Forwarded-For con la IP real del cliente (no confía en la que manda): CLIENT_IP_HEADER=x-forwarded-for.
	reverse_proxy 127.0.0.1:8787
}

# Relay del HUD (plan docs/bitacora/2026-10-29-hud-relay-vps): cada streamer entra con su token en la ruta
# (/s/<token>/hud); sin token válido el relay responde 404. Sin `comun`: la compresión puede retener los eventos (SSE)
# del HUD, y el Referer tiene que ir vacío para que el token no salga a Google Fonts.
hud.cmleague.lat {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Los tokens van en la ruta: el log guarda solo el código y la duración, sin la URL.
	log {
		output file /var/log/caddy/hud.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
			}
		}
	}
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1
	}
}
