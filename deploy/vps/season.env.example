# /etc/cmleague/season.env (root, 600). Para las tareas con la clave de servicio: el cierre de temporadas (cmleague-season)
# y las notificaciones programadas (cmleague-notify). Es el único lugar con esa clave.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Worker del matchmaking (cmleague-mm, replanteo 75): el aviso de reemplazos en Discord. Los mismos valores que el aviso de
# la cola en api.env. Sin el webhook, los reemplazos se abren igual pero no se avisan.
DISCORD_QUEUE_WEBHOOK_URL=
DISCORD_QUEUE_ROLE_ID=
FRONTEND_URL=https://cmleague.lat
