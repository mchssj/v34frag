# /etc/cmleague/demos.env (root, 600). Tarea de demos por SFTP (plan docs/bitacora/2026-10-28-demos-servidores-externos).
# Apunta a PRODUCCIÓN: usa el mismo token que el Worker de demos (solo las funciones demo_*) y la clave pública,
# no la de servicio.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DEMO_WORKER_TOKEN=
# Token de R2 solo del bucket csstv-demos (CF_R2_ACCESS_KEY_ID_DEMOS y CF_R2_SECRET_ACCESS_DEMOS del .env).
R2_ACCOUNT_ID=fedc1b8398e60e62e1b42b4711104404
R2_BUCKET=csstv-demos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcionales (estos son los valores por defecto).
DEMO_DIR=/cstrike/csstv_demos
DELETE_AFTER_UPLOAD=true
STABLE_SECONDS=5
