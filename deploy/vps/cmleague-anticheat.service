# Limpieza del anticheat (docs/bitacora/2026-11-27-anticheat-sin-eac): borra las capturas a los 7 días y las sesiones a los 30.
# Lo lanza cmleague-anticheat.timer.
[Unit]
Description=CMLeague: limpieza del anticheat
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/cmleague/api/current/anticheat-tick.mjs

[Service]
Type=oneshot
User=cmleague
Group=cmleague
WorkingDirectory=/srv/cmleague/api/current
EnvironmentFile=/etc/cmleague/season.env
ExecStart=/usr/bin/node --enable-source-maps /srv/cmleague/api/current/anticheat-tick.mjs
TimeoutStartSec=120
MemoryMax=256M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/srv/cmleague
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
