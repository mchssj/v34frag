+	m.AddItem("switch", side == TEAM_CT ? "Cambiar a T" : "Cambiar a CT");
+	m.ExitButton = false;
+	m.Display(client, secs);
+}
+
+public int Menu_Knife(Menu menu, MenuAction action, int client, int item)
+{
+	if (action == MenuAction_End)
