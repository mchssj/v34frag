+/** El capitán del equipo ganador si sigue en el servidor y en el equipo; si no, 0. Puede ser un bot (solo en pruebas). */
+int Knife_Captain()
+{
+	int c = GetClientOfUserId(g_iCaptain[g_iKnifeWinner]);
