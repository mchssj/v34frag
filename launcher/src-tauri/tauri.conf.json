{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CMLeague",
  "version": "0.1.0",
  "identifier": "lat.cmleague.launcher",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CMLeague",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "url": "https://cmleague.lat/play"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
