{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CMLeague",
  "version": "0.1.1",
  "identifier": "lat.cmleague.launcher",
  "build": {
    "frontendDist": "../local"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "cmleague"
        ]
      }
    }
  }
}
